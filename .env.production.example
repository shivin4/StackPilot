# Copy to .env on your EC2 server before: docker compose up -d --build

POSTGRES_USER=stackpilot
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS
POSTGRES_DB=stackpilot
DATABASE_URL=postgresql://stackpilot:CHANGE_ME_STRONG_PASSWORD_32_CHARS@db:5432/stackpilot

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_RANDOM_SECRET

# Your public URL (no trailing slash) — EC2 public IP or domain
PLATFORM_BASE_URL=http://YOUR_EC2_PUBLIC_IP
VITE_API_URL=/api

DEPLOY_HOST=host.docker.internal
