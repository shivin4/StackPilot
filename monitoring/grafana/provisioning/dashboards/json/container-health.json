{
  "id": null,
  "uid": "stackpilot-container-health",
  "title": "StackPilot - Container Health",
  "tags": ["stackpilot", "containers"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Container CPU Usage (cores)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (cgroup) (label_replace(rate(container_cpu_usage_seconds_total{id!=\"/\", id!=\"\"}[5m]), \"cgroup\", \"$1\", \"id\", \".*/([^/]+)$\"))",
          "legendFormat": "{{cgroup}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container Memory Usage (bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (cgroup) (label_replace(container_memory_usage_bytes{id!=\"/\", id!=\"\"}, \"cgroup\", \"$1\", \"id\", \".*/([^/]+)$\"))",
          "legendFormat": "{{cgroup}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network Receive Rate (bytes/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (cgroup) (label_replace(rate(container_network_receive_bytes_total{id!=\"/\", id!=\"\"}[5m]), \"cgroup\", \"$1\", \"id\", \".*/([^/]+)$\"))",
          "legendFormat": "{{cgroup}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(node_network_receive_bytes_total{device!=\"lo\"}[5m]))",
          "legendFormat": "host (node-exporter)",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container Restarts (10m changes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (cgroup) (label_replace(changes(container_start_time_seconds{id!=\"/\", id!=\"\"}[10m]), \"cgroup\", \"$1\", \"id\", \".*/([^/]+)$\"))",
          "legendFormat": "{{cgroup}}",
          "refId": "A"
        }
      ]
    }
  ]
}
