{
  "id": null,
  "uid": "stackpilot-container-health",
  "title": "StackPilot - Container Health",
  "tags": ["stackpilot", "containers"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Container CPU Usage (cores)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (container) (label_replace(rate(container_cpu_usage_seconds_total{id=~\".*docker.*\"}[5m]), \"container\", \"$1\", \"id\", \".*/docker[-/]([a-f0-9]{12}).*\"))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container Memory Usage (bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (container) (label_replace(container_memory_usage_bytes{id=~\".*docker.*\"}, \"container\", \"$1\", \"id\", \".*/docker[-/]([a-f0-9]{12}).*\"))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network Receive Rate (bytes/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (container) (label_replace(rate(container_network_receive_bytes_total{id=~\".*docker.*\"}[5m]), \"container\", \"$1\", \"id\", \".*/docker[-/]([a-f0-9]{12}).*\"))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container Restarts (10m changes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (container) (label_replace(changes(container_start_time_seconds{id=~\".*docker.*\"}[10m]), \"container\", \"$1\", \"id\", \".*/docker[-/]([a-f0-9]{12}).*\"))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ]
    }
  ]
}
