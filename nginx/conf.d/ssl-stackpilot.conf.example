# Copy to ssl-stackpilot.conf after obtaining certs (see docs/HTTPS.md).
# Requires: docker compose mounts /etc/letsencrypt:/etc/letsencrypt:ro and ports 443:443

server {
    listen 80;
    server_name stackpilot.duckdns.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name stackpilot.duckdns.org;

    ssl_certificate     /etc/letsencrypt/live/stackpilot.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stackpilot.duckdns.org/privkey.pem;

    client_max_body_size 50M;

    location / {
        proxy_pass http://stackpilot_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        rewrite ^/api/(.*) /$1 break;
        proxy_pass http://stackpilot_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /apps/ {
        proxy_pass http://stackpilot_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
