# Copy to .env and fill in values
POSTGRES_USER=stackpilot
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=stackpilot
DATABASE_URL=postgresql://stackpilot:change_me_strong_password@db:5432/stackpilot

SECRET_KEY=change_me_random_32_chars_minimum
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Public URL of your platform (local or production) — no trailing slash
PLATFORM_BASE_URL=http://localhost
VITE_API_URL=/api
DEPLOY_HOST=host.docker.internal

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Azure (Phase 3) — optional
AZURE_STORAGE_CONNECTION_STRING=

# GitHub OAuth (optional Phase 2+)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
